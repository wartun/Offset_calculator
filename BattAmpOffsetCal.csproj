<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds BattAmpOffsetCal.dll against an installed Mission Planner (1.3.83 targets .NET Framework 4.7.2).
       Different install folder: dotnet build -c Release -p:MissionPlannerDir="D:\Mission Planner" -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>BattAmpOffsetCal</AssemblyName>
    <RootNamespace>BattAmpOffsetCal</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <MissionPlannerDir Condition="'$(MissionPlannerDir)' == ''">C:\Program Files (x86)\Mission Planner</MissionPlannerDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- lets the project build without the .NET Framework 4.7.2 developer pack -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <!-- Mission Planner assemblies: compile against them, never copy them to the output -->
    <Reference Include="MissionPlanner">
      <HintPath>$(MissionPlannerDir)\MissionPlanner.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MissionPlanner.ArduPilot">
      <HintPath>$(MissionPlannerDir)\MissionPlanner.ArduPilot.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Interfaces">
      <HintPath>$(MissionPlannerDir)\Interfaces.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MissionPlanner.Utilities">
      <HintPath>$(MissionPlannerDir)\MissionPlanner.Utilities.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MAVLink">
      <HintPath>$(MissionPlannerDir)\MAVLink.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
